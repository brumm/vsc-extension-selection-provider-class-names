{
  "name": "vsc-extension-selection-provider-class-names",
  "displayName": "Class Name Selection Ranges",
  "description": "Adds individual class names to VS Code's Expand and Shrink Selection hierarchy.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Class Name Selection",
      "properties": {
        "classNameSelection.classFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "cn",
            "clsx",
            "cva",
            "classNames",
            "twMerge"
          ],
          "description": "Function calls whose string values contain class names."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
